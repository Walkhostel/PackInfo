pkgname=packinfo
pkgver=1.0.0
pkgrel=1
pkgdesc="Show all info about all installed packages due pacman"
arch=('x86_64')
url="https://github.com/Walkhostel/Packinfo"
license=('GPL-3.0-or-later')
depends=('gcc-libs')
makedepends=('cargo' 'git')
source=("git+$url.git")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    cargo fetch --locked
}

build() {
    cd "$pkgname"
    cargo build --release --locked
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/pacinfo "$pkgdir/usr/bin/pacinfo"
}
